.venv/
*.local.ps1

# 세션이 편집한 파일 기록(touch_log.py) — 로컬 런타임 산출물이지 설정이 아니다.
# 커밋되면 남의 PC 세션 id 가 이력에 남고, commit_sentinel 이 낡은 기록으로 오탐한다.
.claude/sessions/

# ci_index.py 가 만드는 문서 인덱스 — 파생물이다. 공유되는 건 스크립트지 결과가 아니다.
# 커밋하면 안 되는 이유: Obsidian 쪽 갱신일이 파일 mtime 이라 두 PC 가 서로 다른 값을
# 내고 매번 530줄이 통째로 충돌한다(메모리를 Drive 로 뺀 것과 같은 이유).
# 검색(`--search`)은 이 파일을 읽지 않고 매번 라이브 스캔하므로 낡아서 손해 볼 일도 없다.
_ci/

# ── home/skills ──────────────────────────────────────────────
__pycache__/
*.pyc
node_modules/
dist/
.DS_Store
Thumbs.db

# forge 레포(Desktop/forge)로 심링크된 스킬 — 정본은 그쪽
skills/arch-forge
skills/backend-forge
skills/forge-loop
skills/frontend-forge
# ── local machine wiring, not plugin package ─────────────────────────────
# 이 레포는 gg-harness plugin source다. PC 배선/전역 설정/워크트리 런처는
# GitHub plugin 패키지에 넣지 않는다. 필요하면 로컬에만 둔다.
.claude/
.githooks/
install.ps1
home/
powershell/
hooks/
projects/
scripts/
gitignore_global
새PC.md
운영_워크플로우.md
북마크_레포.md

# shared Claude Code hook engines (bookmart/Coupang shims call these)
!hooks/
!hooks/**
