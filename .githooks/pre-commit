#!/bin/bash
# 이 레포(설정 정본)를 커밋할 때 도는 검사들.
# 배선은 install.ps1 의 `git config core.hooksPath .githooks`.
# 급할 때: git commit --no-verify
#
# 원칙: **자동이 아닌 검사는 안 돈다.** 오늘 하루에만 같은 패턴으로 세 번 데였다
# (백틱 파일명 · CONTEXT_GLOBS 밖 문서 · .husky 관례). 그래서 여기 모은다.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
fail=0

# ── ① 스킬 폴더 ↔ home/skills/README.md 등록 대조 ────────────────────────
# README 규칙이 "등록 안 된 스킬은 없는 것과 같다" 인데 지키는 장치가 없어서
# forge 4종이 조용히 빠져 있었다(2026-08-06 발견). description 만 컨텍스트에 올라가는
# 구조라 **README 에 없으면 사람도 에이전트도 그 스킬의 존재를 모른다.**
# 개수가 아니라 이름으로 대조한다 — 하나 지우고 하나 더하면 개수는 그대로다.
if [ -f "$root/home/skills/README.md" ]; then
  cd "$root/home/skills" || exit 0
  have=$(ls -d */ 2>/dev/null | sed 's#/##' | sort)
  listed=$(grep -o '^| \*\*[A-Za-z0-9_-]*\*\*' README.md | sed 's/^| \*\*//; s/\*\*$//' | sort)
  missing=$(comm -23 <(echo "$have") <(echo "$listed"))
  stale=$(comm -13 <(echo "$have") <(echo "$listed"))
  if [ -n "$missing" ] || [ -n "$stale" ]; then
    echo "✗ home/skills/README.md 와 실제 스킬 폴더가 어긋납니다."
    [ -n "$missing" ] && echo "  README 에 없는 스킬(등록 필요):" && echo "$missing" | sed 's/^/    - /'
    [ -n "$stale"   ] && echo "  폴더가 없는데 README 에 남은 항목:" && echo "$stale"   | sed 's/^/    - /'
    echo "  → README 표에 한 줄 추가/삭제 후 다시 커밋하세요."
    fail=1
  fi
  cd "$root" || exit 0
fi

# ── ② TDD 가드 엔진 selftest ─────────────────────────────────────────────
# 엔진이 한 벌이라 여기서 깨뜨리면 bookmart·Coupang 이 **동시에** 죽는다.
# 그런데 이 selftest 는 어디서도 안 돌고 있었다(2026-08-06):
#   · claude 레포엔 CI 가 없다
#   · bookmart CI 에 넣어도 러너엔 ~/claude 가 없어 shim 이 exit 0 → 「통과」라는 거짓 신호
# 그래서 엔진이 사는 이 레포에서, 엔진을 건드린 커밋에서만 돌린다.
for _e in tdd_guard commit_sentinel touch_log; do
  git diff --cached --name-only | grep -q "^hooks/$_e\.py$" || continue
  if ! python "$root/hooks/$_e.py" --selftest; then
    echo "✗ $_e selftest 실패 — 엔진을 고치면 세 레포가 같이 영향받습니다."
    fail=1
  fi
done

exit $fail
